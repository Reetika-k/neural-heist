{
  "name": "neural-heist",
  "version": "1.0.0",
  "private": true,
  "description": "Browser stealth-action game where you train your own AI teammates (IIT Patna capstone, Project 2)",
  "type": "module",
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "dev:llm": "node tools/llm-dev-proxy.mjs",
    "test:e2e": "node tests/e2e-browser.mjs",
    "test:phone": "node tests/phone-check.mjs",
    "test:tap": "mkdir -p tests/results && node --test --test-reporter=tap --test-reporter-destination=tests/results/unit-latest.tap tests/*.test.mjs",
    "dashboard": "node scripts/build-dashboard.mjs",
    "test:scores": "node tests/score-scenarios.mjs",
    "submission": "node scripts/build-submission.mjs",
    "record:demo": "node tools/record-walkthrough.mjs",
    "test:safari": "node tests/safari-check.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
